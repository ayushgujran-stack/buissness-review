rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & AUTHORIZATION HELPERS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.uid == 'super_admin_reviewflow'
      );
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaffMember(ownerId) {
      return isAuthenticated() &&
        getUserDoc().data.owner_id == ownerId &&
        getUserDoc().data.status == 'active';
    }

    function isTenantUser(ownerId) {
      return isOwner(ownerId) || isStaffMember(ownerId) || isSuperAdmin();
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Users can read themselves; Owners can read their staff; SuperAdmin can read all
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      // Owner can create/update team members under their owner_id; users can update own profile
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 2. BUSINESSES COLLECTION
    // ==========================================
    match /businesses/{businessId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow create: if isAuthenticated() && (
        request.resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 3. BRANCHES COLLECTION
    // Creation is strictly handled via Cloud Function (createBranch)
    // to enforce atomic multi-business branch limit transaction!
    // ==========================================
    match /branches/{branchId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow create: if isSuperAdmin(); // Normal tenants create exclusively via createBranch Cloud Function
      allow update: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 4. USER ACCESS (RBAC assignments)
    // ==========================================
    match /user_access/{accessId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.owner_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // ==========================================
    // 5. REVIEW FORMS & QUESTIONS
    // ==========================================
    match /review_forms/{formId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow create, update: if isAuthenticated() && (
        request.resource.data.owner_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /review_form_pages/{pageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.data.owner_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /review_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.data.owner_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /question_options/{optionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() || isSuperAdmin();
    }

    // ==========================================
    // 6. QR CODES
    // ==========================================
    match /qr_codes/{qrId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow write: if isAuthenticated() && (
        request.resource.data.owner_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // ==========================================
    // 7. CUSTOMERS (Strictly isolated to tenant)
    // ==========================================
    match /customers/{customerId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow write: if false; // Ingested solely via trusted backend functions
    }

    // ==========================================
    // 8. REVIEWS & REVIEW ANSWERS (Strictly Immutable)
    // Written ONLY via Cloud Functions; Deletion forbidden!
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow create, update, delete: if false; // Ingested solely via submitCustomerReview Cloud Function
    }

    match /review_answers/{answerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false; // Ingested solely via submitCustomerReview Cloud Function
    }

    // ==========================================
    // 9. LICENSE PLANS & LICENSES
    // Client cannot directly modify license limits, status, or expiry!
    // ==========================================
    match /license_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /licenses/{licenseId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow write: if false; // Managed exclusively via Cloud Functions
    }

    // ==========================================
    // 10. PAYMENTS (Razorpay transactions)
    // ==========================================
    match /payments/{paymentId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow write: if false; // Verified and recorded exclusively via Cloud Functions
    }

    // ==========================================
    // 11. NOTIFICATIONS & RECIPIENTS
    // ==========================================
    match /notifications/{notifId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow write: if false; // Generated exclusively by Cloud Functions
    }

    match /notification_recipients/{recId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create, delete: if false;
    }

    // ==========================================
    // 12. PUSH DEVICES (FCM device tokens)
    // ==========================================
    match /push_devices/{deviceId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.user_id ||
        (resource != null && request.auth.uid == resource.data.user_id)
      );
    }

    // ==========================================
    // 13. AUDIT LOGS (Immutable Compliance Journal)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isTenantUser(resource.data.owner_id);
      allow write: if false; // Generated exclusively by Cloud Functions / backend transactions
    }

    // ==========================================
    // 14. PLATFORM SETTINGS
    // ==========================================
    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
