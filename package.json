{
  "name": "review-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/customer-web",
    "dev:customer": "npm run dev --workspace=apps/customer-web",
    "dev:owner": "npm run start --workspace=apps/owner-app",
    "dev:owner:web": "npm run web --workspace=apps/owner-app",
    "dev:owner:android": "npm run android --workspace=apps/owner-app",
    "dev:owner:ios": "npm run ios --workspace=apps/owner-app",
    "build": "npm run build --workspace=apps/customer-web",
    "build:apk": "npm run build:apk --workspace=apps/owner-app"
  }
}
